{
  extends: ['config:base', 'group:allNonMajor'],
  labels: ['dependencies'],
  dependencyDashboard: false,
  minimumReleaseAge: '2 days',
  pin: false,
  rangeStrategy: 'bump',
  packageRules: [
    {
      // Exclude all the packages that I personally maintain from minimumReleaseAge
      matchPackagePatterns: ['^cli-nano$'],
      minimumReleaseAge: '0',
    },
  ],
  ignoreDeps: ['node'],
  schedule: ['every 3 months'],
}
